<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium E2E Automation Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <test name="Authentication Tests">
        <classes>
            <class name="com.qa.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Product Catalog Tests">
        <classes>
            <class name="com.qa.tests.ProductCatalogTests"/>
        </classes>
    </test>

    <test name="Cart Workflow Tests">
        <classes>
            <class name="com.qa.tests.CartWorkflowTests"/>
        </classes>
    </test>

    <test name="End-to-End Checkout Tests">
        <classes>
            <class name="com.qa.tests.EndToEndCheckoutTests"/>
        </classes>
    </test>

</suite>

